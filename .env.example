# Required public Supabase client configuration
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key
# Deployed shared R2 API for 3D models, profile pictures, and class images. The
# Worker's own configuration controls its model capacity and file limits.
REACT_APP_R2_MODEL_API_URL=https://elikha-r2-models.your-subdomain.workers.dev

# Optional URL overrides used by the password-reset flow
REACT_APP_SITE_URL=http://localhost:3000
REACT_APP_PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/reset-password
