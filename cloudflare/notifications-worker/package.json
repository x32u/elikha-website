{
  "name": "elikha-notifications-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run types:check && tsc --noEmit",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --test-scheduled",
