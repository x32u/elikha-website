{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elikha-r2-models",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-09",
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "MODEL_BUCKET",
      "bucket_name": "elikha-3d-models"
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://qoixmfuxinmbtwfrhles.supabase.co",
    "ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000",
    "MODEL_STORAGE_CAPACITY_BYTES": "1073741824",
    "MAX_MODEL_FILE_BYTES": "52428800"
  }
}
